rules_version = '2';
// Security rules for the NL Oefenbank.
// Paste into Firebase Console > Firestore Database > Rules, then Publish.
//
// users/{uid}             profile: name, email, photo, type, role, groep, exams, dates, seen{page: time}
// users/{uid}/attempts/*  finished practice rounds (owner and admin read them; admin for the statistics)
//
// type ("adult" | "child") : chosen once by the user, after that only admin changes it
// role ("member" | "teacher" | "admin") : only admin changes it, nobody can give it to themselves
// status ("pending" | "approved" | "blocked") : new accounts are pending; only admin approves
// parent_uid : a child's linked parent account; only admin sets it
// welcome_sent_at : set by the mailer job (service account, not bound by these rules)
// announcements/*  : written by admin, sent by the mailer job
// nieuws_sent/{date}: news mail log, written by the mailer job, read by approved users
// settings/mail     : mail schedule (day + hour per job), edited on the admin page, read by the mailer job
// mail_log/*        : weekly summary log, written by the mailer job, read by admin
// leaderboard/{day}/entries/{key-uid} : Slimspel daily ranking (first name, time, hints); children write
//                    their own entry once, approved accounts read it
// The very first admin is set by hand in the Firebase Console (role = "admin").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Admin = the caller's own profile says role "admin"
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function validType(t) { return t in ['adult', 'child']; }
    function validRole(r) { return r in ['member', 'teacher', 'admin']; }
    function validStatus(s) { return s in ['pending', 'approved', 'blocked']; }
    // Approved = admin set status "approved" (admins always count as approved)
    function isApproved(uid) {
      return isAdmin()
        || get(/databases/$(database)/documents/users/$(uid)).data.get('status', '') == 'approved';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // New profile: always starts as a normal, not yet approved member
      allow create: if isOwner(uid)
        && request.resource.data.get('role', 'member') == 'member'
        && request.resource.data.get('status', 'pending') == 'pending'
        && (request.resource.data.get('type', null) == null || validType(request.resource.data.type));

      // Owner edits: never role, status, parent link or mail flags; type only once (when it was still empty)
      allow update: if (isOwner(uid)
          && !changed().hasAny(['role', 'status', 'parent_uid', 'welcome_sent_at'])
          && (!changed().hasAny(['type'])
              || (resource.data.get('type', null) == null && validType(request.resource.data.type))))
        || (isAdmin()
          && validRole(request.resource.data.get('role', 'member'))
          && validStatus(request.resource.data.get('status', 'pending'))
          && (request.resource.data.get('parent_uid', null) == null || request.resource.data.parent_uid is string)
          && (request.resource.data.get('type', null) == null || validType(request.resource.data.type)));

      allow delete: if isAdmin();

      // Finished rounds: owner only, and only after approval. Added, never edited.
      match /attempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isApproved(uid)
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 50;
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // Announcements: only admins write and read them; the mailer job sends them
    match /announcements/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 4000
        && request.resource.data.sent_at == null
        && request.resource.data.get('audience', 'all') in ['all', 'adult', 'child'];
      allow delete: if isAdmin();
      allow update: if false;
    }

    // News mail log: which item was mailed on which day
    match /nieuws_sent/{date} {
      allow read: if signedIn() && isApproved(request.auth.uid);
      allow write: if false;
    }

    // Site settings (mail schedule): admin only
    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    // Mailer job's own log (weekly summary): admin may read it
    match /mail_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Slimspel daily ranking. One document per child, per daily puzzle: id = "<key>-<uid>",
    // key = game and puzzle, e.g. "sudoku-4x4-makkelijk". Only a first name, time and hints are shared.
    // Written once by the child itself (an existing document cannot be overwritten), read by approved accounts.
    match /leaderboard/{day}/entries/{entryId} {
      allow read: if signedIn() && isApproved(request.auth.uid);
      allow create: if signedIn() && isApproved(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('type', '') == 'child'
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'key', 'time_s', 'hints', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.key is string && request.resource.data.key.size() <= 60
        && entryId == request.resource.data.key + '-' + request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.time_s is int && request.resource.data.time_s >= 1 && request.resource.data.time_s <= 36000
        && request.resource.data.hints is int && request.resource.data.hints >= 0 && request.resource.data.hints <= 200
        && request.resource.data.at is string;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
